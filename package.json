{
  "name": "nightjar-slicer-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.mjs",
    "test": "cargo test && node --test site/tests/wav.test.mjs && npm run test:claims && npm run test:browser && npm run build:site",
    "test:claims": "cargo build --quiet && node --test site/tests/claims.test.mjs",
    "test:browser": "playwright test",
    "verify:live": "node scripts/verify-live.mjs",
    "build": "npm run build:site && npm run build:cli",
    "build:site": "vite build --config site/vite.config.mjs",
    "build:cli": "cargo build --release && node scripts/stage-cli.mjs",
    "preview": "vite preview --config site/vite.config.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.58.2",
    "ajv": "^8.18.0",
    "vite": "^7.1.3"
  }
}
