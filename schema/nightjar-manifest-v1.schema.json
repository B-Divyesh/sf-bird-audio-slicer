{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bird-audio-slicer.sociobot.in/schema/nightjar-manifest-v1.schema.json",
  "title": "Nightjar manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at_unix", "privacy", "source", "settings", "chunks"],
  "properties": {
    "schema": { "const": "nightjar-manifest/v1" },
    "created_at_unix": { "type": "integer", "minimum": 0 },
    "privacy": {
      "type": "object",
      "required": ["source_path_included", "note"],
      "properties": {
        "source_path_included": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "path", "file_bytes", "sample_rate_hz", "channels", "duration_seconds"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "path": { "type": ["string", "null"] },
        "file_bytes": { "type": "integer", "minimum": 1 },
        "sample_rate_hz": { "type": "integer", "minimum": 1 },
        "channels": { "type": "integer", "minimum": 1 },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "settings": {
      "type": "object",
      "required": ["chunk_seconds", "mode", "search_window_seconds", "thumbnails"],
      "properties": {
        "chunk_seconds": { "type": "integer", "minimum": 10, "maximum": 3600 },
        "mode": { "enum": ["fixed", "silence"] },
        "search_window_seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "thumbnails": { "type": "boolean" }
      }
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "start_seconds", "end_seconds", "start_timestamp", "end_timestamp", "file", "spectrogram", "bytes", "status"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "start_seconds": { "type": "number", "minimum": 0 },
          "end_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "start_timestamp": { "type": "string" },
          "end_timestamp": { "type": "string" },
          "file": { "type": "string", "pattern": "^clip_[0-9]{4}_[0-9]{2,}-[0-9]{2}-[0-9]{2}\\.wav$" },
          "spectrogram": { "type": ["string", "null"] },
          "bytes": { "type": "integer", "minimum": 45 },
          "status": { "const": "ready" }
        }
      }
    }
  }
}
